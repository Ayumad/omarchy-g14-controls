#!/usr/bin/env bash
set -euo pipefail

# Allowlisted ASUS controller used by the G14 Controls Omarchy plugin.
# It talks to asusd through asusctl; no administrative access is requested here.

notify() {
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g  "G14" "$*" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "G14" "$*" >/dev/null 2>&1 || true
  fi
}

# Profile cycling can be triggered quickly from the hardware key.  Keep one
# notification per login session and replace its contents on every change.
profile_notification_file="${XDG_RUNTIME_DIR:-/tmp}/g14ctl-profile-notification-${UID}"

notify_profile() {
  local replace_id="" notification_id=""
  [[ -r "$profile_notification_file" ]] && read -r replace_id < "$profile_notification_file" || true

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    if [[ "$replace_id" =~ ^[1-9][0-9]*$ ]]; then
      notification_id=$(omarchy-notification-send -g  "G14" "$*" -r "$replace_id" -p 2>/dev/null || true)
    else
      notification_id=$(omarchy-notification-send -g  "G14" "$*" -p 2>/dev/null || true)
    fi
  elif command -v notify-send >/dev/null 2>&1; then
    if [[ "$replace_id" =~ ^[1-9][0-9]*$ ]]; then
      notification_id=$(notify-send -p -r "$replace_id" "G14" "$*" 2>/dev/null || true)
    else
      notification_id=$(notify-send -p "G14" "$*" 2>/dev/null || true)
    fi
  fi

  if [[ "$notification_id" =~ ^[1-9][0-9]*$ ]]; then
    (umask 077; printf '%s\n' "$notification_id" > "$profile_notification_file") 2>/dev/null || true
  else
    notify "$@"
  fi
}

refresh_profile_widget() {
  local profile="${1:-}"
  command -v omarchy-shell >/dev/null 2>&1 \
    && omarchy-shell -q ayumad.g14-controls profileChanged "$profile" >/dev/null 2>&1 \
    || true
}

die() {
  printf 'g14ctl: %s\n' "$*" >&2
  exit 2
}

asusctl_bin="${ASUSCTL_BIN:-$(command -v asusctl || true)}"
[[ -x "$asusctl_bin" ]] || die "asusctl is not installed or not on PATH"
command -v jq >/dev/null 2>&1 || die "jq is required for status output"

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
aura_lock_state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/ayumad.g14-controls"
aura_lock_file="$aura_lock_state_dir/keyboard-lighting.lock"
aura_lock_hook="${XDG_CONFIG_HOME:-${HOME}/.config}/omarchy/hooks/theme-set.d/ayumad-g14-controls"
aura_lock_hook_template="$plugin_dir/theme-set-hook"

read_value() {
  local path="$1"
  if [[ -r "$path" ]]; then
    tr -d '[:space:]' < "$path"
  else
    printf '?'
  fi
}

sysfs_value() {
  local name="$1" path
  for path in \
    "/sys/devices/platform/asus-nb-wmi/$name" \
    "/sys/devices/platform/asus-wmi/$name"; do
    if [[ -r "$path" ]]; then
      tr -d '[:space:]' < "$path"
      return
    fi
  done
  printf '?'
}

gpu_mode() {
  local disabled mux
  disabled=$(sysfs_value dgpu_disable)
  mux=$(sysfs_value gpu_mux_mode)
  if [[ "$disabled" == 1 ]]; then
    printf 'integrated'
  elif [[ "$mux" == 0 ]]; then
    printf 'ultimate'
  elif [[ "$mux" == 1 ]]; then
    printf 'hybrid'
  else
    printf 'unknown'
  fi
}

profile_name() {
  "$asusctl_bin" profile get 2>/dev/null \
    | sed -n 's/^Active profile:[[:space:]]*//p' \
    | head -n1 \
    || true
}

adaptive_profile_enabled() {
  local output ac_profile battery_profile
  output=$("$asusctl_bin" profile get 2>/dev/null || true)
  ac_profile=$(printf '%s\n' "$output" | sed -n 's/^AC profile[[:space:]]*//p' | head -n1)
  battery_profile=$(printf '%s\n' "$output" | sed -n 's/^Battery profile[[:space:]]*//p' | head -n1)
  [[ "$ac_profile" == "Balanced" && "$battery_profile" == "Quiet" ]] && printf 'true' || printf 'false'
}

keyboard_level() {
  local output level
  output=$("$asusctl_bin" leds get 2>/dev/null || true)
  level=$(printf '%s\n' "$output" | sed -n 's/.*brightness:[[:space:]]*//Ip' | tail -n1)
  if [[ -n "$level" ]]; then
    printf '%s' "$level"
  else
    printf '%s\n' "$output" | tail -n1 | sed -n 's/.*:[[:space:]]*//p' | sed 's/[[:space:]]*$//'
  fi
}

aura_config() {
  local path
  for path in /etc/asusd/aura_*.ron; do
    if [[ -r "$path" ]]; then
      printf '%s' "$path"
      return
    fi
  done
  printf '?'
}

aura_mode_name() {
  local config mode
  config=$(aura_config)
  [[ -r "$config" ]] || { printf 'static'; return; }
  mode=$(sed -n 's/.*current_mode:[[:space:]]*\([A-Za-z0-9_]*\),.*/\1/p' "$config" | head -n1)
  case "$mode" in
    Static) printf 'static' ;;
    Breathe) printf 'breathe' ;;
    RainbowCycle) printf 'rainbow-cycle' ;;
    RainbowWave) printf 'rainbow-wave' ;;
    Pulse) printf 'pulse' ;;
    *) printf 'static' ;;
  esac
}

aura_color() {
  local config mode block r g b
  config=$(aura_config)
  [[ -r "$config" ]] || { printf 'ff2244'; return; }
  mode=$(sed -n 's/.*current_mode:[[:space:]]*\([A-Za-z0-9_]*\),.*/\1/p' "$config" | head -n1)
  [[ -n "$mode" ]] || { printf 'ff2244'; return; }
  block=$(awk -v mode="$mode" '
    $0 ~ "^[[:space:]]*" mode ":[[:space:]]*\\(" { inside=1; next }
    inside && /colour1:[[:space:]]*\(/ { colour=1; next }
    colour && /colour2:[[:space:]]*\(/ { exit }
    colour { print }
  ' "$config")
  r=$(printf '%s\n' "$block" | sed -n 's/.*r:[[:space:]]*\([0-9][0-9]*\),.*/\1/p' | head -n1)
  g=$(printf '%s\n' "$block" | sed -n 's/.*g:[[:space:]]*\([0-9][0-9]*\),.*/\1/p' | head -n1)
  b=$(printf '%s\n' "$block" | sed -n 's/.*b:[[:space:]]*\([0-9][0-9]*\),.*/\1/p' | head -n1)
  if [[ "$r" =~ ^[0-9]+$ && "$g" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] \
    && ((r <= 255 && g <= 255 && b <= 255)); then
    printf '%02x%02x%02x' "$r" "$g" "$b"
  else
    printf 'ff2244'
  fi
}

aura_lock_values() {
  local mode colour
  [[ -r "$aura_lock_file" ]] || return 1
  mode=$(sed -n 's/^mode=//p' "$aura_lock_file" | head -n1)
  colour=$(sed -n 's/^colour=//p' "$aura_lock_file" | head -n1)
  [[ "$mode" =~ ^(static|breathe|rainbow-cycle|rainbow-wave|pulse)$ ]] || return 1
  [[ "$colour" =~ ^[0-9A-Fa-f]{6}$ ]] || return 1
  printf '%s %s\n' "$mode" "${colour,,}"
}

aura_lock_enabled() {
  aura_lock_values >/dev/null
}

write_aura_lock() {
  local mode="${1:-}" colour="${2:-}"
  [[ "$mode" =~ ^(static|breathe|rainbow-cycle|rainbow-wave|pulse)$ ]] || die "unsupported Aura mode for color lock"
  [[ "$colour" =~ ^[0-9A-Fa-f]{6}$ ]] || die "invalid Aura color for color lock"
  mkdir -p "$aura_lock_state_dir"
  (umask 077; printf 'mode=%s\ncolour=%s\n' "$mode" "${colour,,}" > "$aura_lock_file")
}

install_aura_lock_hook() {
  [[ -x "$aura_lock_hook_template" ]] || die "keyboard-color lock hook is unavailable"
  install -Dm700 "$aura_lock_hook_template" "$aura_lock_hook"
}

apply_aura_effect() {
  local mode="${1:-}" colour="${2:-}"
  case "$mode" in
    static) "$asusctl_bin" aura effect static --colour "$colour" ;;
    breathe) "$asusctl_bin" aura effect breathe --colour "$colour" --colour2 000000 --speed med ;;
    rainbow-cycle) "$asusctl_bin" aura effect rainbow-cycle --speed med ;;
    rainbow-wave) "$asusctl_bin" aura effect rainbow-wave --direction right --speed med ;;
    pulse) "$asusctl_bin" aura effect pulse --colour "$colour" ;;
    *) die "aura mode must be static, breathe, rainbow-cycle, rainbow-wave, or pulse" ;;
  esac
}

set_aura_lock() {
  local action="${1:-}" mode colour
  case "$action" in
    on)
      mode=$(aura_mode_name)
      colour=$(aura_color)
      write_aura_lock "$mode" "$colour"
      install_aura_lock_hook
      notify "Keyboard color lock: on"
      ;;
    off)
      rm -f -- "$aura_lock_file" "$aura_lock_hook"
      notify "Keyboard color lock: off"
      ;;
    apply)
      read -r mode colour < <(aura_lock_values) || return 0
      apply_aura_effect "$mode" "$colour"
      ;;
    *) die "aura-lock must be on, off, or apply" ;;
  esac
}

slash_mode_name() {
  local mode
  mode=$(sed -n 's/.*display_mode:[[:space:]]*\([A-Za-z0-9_]*\),.*/\1/p' /etc/asusd/slash.ron 2>/dev/null | head -n1)
  printf '%s' "${mode:-Bounce}"
}

slash_brightness() {
  local brightness
  brightness=$(sed -n 's/.*brightness:[[:space:]]*\([0-9][0-9]*\),.*/\1/p' /etc/asusd/slash.ron 2>/dev/null | head -n1)
  printf '%s' "${brightness:-255}"
}

slash_enabled() {
  local enabled
  enabled=$(sed -n 's/.*enabled:[[:space:]]*\(true\|false\),.*/\1/p' /etc/asusd/slash.ron 2>/dev/null | head -n1)
  printf '%s' "${enabled:-unknown}"
}

dgpu_slot() {
  local device class boot vendor
  for device in /sys/bus/pci/devices/*; do
    [[ -r "$device/class" ]] || continue
    class=$(tr -d '[:space:]' < "$device/class")
    [[ "$class" == 0x03* ]] || continue
    boot=$(read_value "$device/boot_vga")
    if [[ "$boot" == 0 ]]; then
      basename "$device"
      return
    fi
  done

  # ASUS ROG laptops with an NVIDIA dGPU retain the PCI function even when
  # it is runtime-suspended, so prefer it as a useful fallback.
  for device in /sys/bus/pci/devices/*; do
    [[ -r "$device/vendor" && -r "$device/class" ]] || continue
    vendor=$(tr -d '[:space:]' < "$device/vendor")
    class=$(tr -d '[:space:]' < "$device/class")
    if [[ "$vendor" == 0x10de && "$class" == 0x03* ]]; then
      basename "$device"
      return
    fi
  done
}

dgpu_name() {
  local slot name
  slot=$(dgpu_slot || true)
  [[ -n "$slot" ]] || { printf 'Discrete GPU'; return; }
  command -v lspci >/dev/null 2>&1 || { printf 'Discrete GPU'; return; }
  name=$(lspci -Dmmnn -s "$slot" 2>/dev/null | awk -F '"' '
    /"VGA compatible controller|3D controller|Display controller/ {
      model = $6
      sub(/[[:space:]]+\[[[:xdigit:]]+\]$/, "", model)
      if (match(model, /\[[^]]+\]/))
        print substr(model, RSTART + 1, RLENGTH - 2)
      else {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", model)
        print model
      }
      exit
    }
  ')
  printf '%s' "${name:-Discrete GPU}"
}

dgpu_runtime() {
  local slot
  slot=$(dgpu_slot || true)
  [[ -n "$slot" ]] || { printf 'unknown'; return; }
  read_value "/sys/bus/pci/devices/$slot/power/runtime_status"
}

status_json() {
  local profile adaptive mode disabled mux runtime dgpu keyboard aura colour aura_locked slash brightness enabled
  profile=$(profile_name)
  adaptive=$(adaptive_profile_enabled)
  mode=$(gpu_mode)
  disabled=$(sysfs_value dgpu_disable)
  mux=$(sysfs_value gpu_mux_mode)
  runtime=$(dgpu_runtime)
  dgpu=$(dgpu_name)
  keyboard=$(keyboard_level)
  aura=$(aura_mode_name)
  colour=$(aura_color)
  aura_locked=$(aura_lock_enabled && printf 'true' || printf 'false')
  slash=$(slash_mode_name)
  brightness=$(slash_brightness)
  enabled=$(slash_enabled)
  jq -cn \
    --arg profile "$profile" \
    --argjson adaptive "$adaptive" \
    --arg mode "$mode" \
    --arg disabled "$disabled" \
    --arg mux "$mux" \
    --arg runtime "$runtime" \
    --arg dgpu "$dgpu" \
    --arg keyboard "$keyboard" \
    --arg aura_mode "$aura" \
    --arg aura_color "$colour" \
    --argjson aura_locked "$aura_locked" \
    --arg slash_mode "$slash" \
    --arg slash_brightness "$brightness" \
    --arg slash_enabled "$enabled" \
    '{profile:$profile,adaptive:$adaptive,gpu_mode:$mode,dgpu_disable:$disabled,gpu_mux_mode:$mux,dgpu_name:$dgpu,dgpu_runtime:$runtime,nvidia_runtime:$runtime,keyboard_brightness:$keyboard,aura_mode:$aura_mode,aura_color:$aura_color,aura_locked:$aura_locked,slash_mode:$slash_mode,slash_brightness:$slash_brightness,slash_enabled:$slash_enabled}'
}

set_profile() {
  local profile="${1:-}" applied_profile=""
  case "$profile" in
    quiet|Quiet) profile="Quiet" ;;
    balanced|Balanced) profile="Balanced" ;;
    performance|Performance) profile="Performance" ;;
    next|cycle)
      "$asusctl_bin" profile next
      applied_profile=$(profile_name)
      refresh_profile_widget "$applied_profile"
      notify_profile "Profile: $applied_profile"
      return
      ;;
    adaptive)
      "$asusctl_bin" profile set --ac Balanced
      "$asusctl_bin" profile set --battery Quiet
      refresh_profile_widget "$(profile_name)"
      notify_profile "Adaptive profiles: AC Balanced / battery Quiet"
      return
      ;;
    *) die "profile must be quiet, balanced, performance, next, or adaptive" ;;
  esac
  "$asusctl_bin" profile set "$profile"
  refresh_profile_widget "$profile"
  notify_profile "Profile: $profile"
}

set_graphics() {
  local requested="${1:-}" disabled mux
  case "$requested" in
    integrated) disabled=1; mux=1 ;;
    hybrid) disabled=0; mux=1 ;;
    ultimate|discrete) disabled=0; mux=0; requested=ultimate ;;
    *) die "graphics must be integrated, hybrid, or ultimate" ;;
  esac
  if command -v nvidia-smi >/dev/null 2>&1 \
    && nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | grep -q '[0-9]'; then
    die "NVIDIA processes are active; close them before scheduling a GPU mode change"
  fi
  "$asusctl_bin" armoury set dgpu_disable "$disabled"
  "$asusctl_bin" armoury set gpu_mux_mode "$mux"
  notify "GPU mode scheduled: $requested (reboot required)"
}

set_keyboard() {
  case "${1:-}" in
    off|low|med|high) "$asusctl_bin" leds set "$1" ;;
    up|cycle) "$asusctl_bin" leds next ;;
    down) "$asusctl_bin" leds prev ;;
    *) die "keyboard level must be off, low, med, high, up, down, or cycle" ;;
  esac
  notify "Keyboard backlight: $(keyboard_level)"
}

set_aura_mode() {
  local mode="${1:-}" colour="${2:-ff2244}"
  [[ "$colour" =~ ^[0-9A-Fa-f]{6}$ ]] || die "aura color must be a 6-digit RGB value, e.g. 33ccff"
  apply_aura_effect "$mode" "$colour"
  aura_lock_enabled && write_aura_lock "$mode" "$colour" || true
  notify "Keyboard Aura: $mode"
}

set_slash_mode() {
  local requested="${1:-}" mode
  case "$requested" in
    static|Static) mode=Static ;;
    bounce|Bounce) mode=Bounce ;;
    slash|Slash) mode=Slash ;;
    loading|Loading) mode=Loading ;;
    bitstream|BitStream) mode=BitStream ;;
    transmission|Transmission) mode=Transmission ;;
    flow|Flow) mode=Flow ;;
    flux|Flux) mode=Flux ;;
    phantom|Phantom) mode=Phantom ;;
    spectrum|Spectrum) mode=Spectrum ;;
    hazard|Hazard) mode=Hazard ;;
    interfacing|Interfacing) mode=Interfacing ;;
    ramp|Ramp) mode=Ramp ;;
    gameover|GameOver) mode=GameOver ;;
    start|Start) mode=Start ;;
    buzzer|Buzzer) mode=Buzzer ;;
    *) die "unsupported Slash mode: $requested" ;;
  esac
  "$asusctl_bin" slash --mode "$mode"
  notify "Slash mode: $mode"
}

set_slash_brightness() {
  local brightness="${1:-}"
  [[ "$brightness" =~ ^[0-9]+$ && "$brightness" -le 255 ]] || die "Slash brightness must be 0-255"
  "$asusctl_bin" slash --brightness "$brightness"
  notify "Slash brightness: $brightness/255"
}

toggle_airplane() {
  command -v rfkill >/dev/null 2>&1 || die "rfkill is not installed"
  local soft_blocked
  soft_blocked=$(rfkill list 2>/dev/null | awk -F': ' '/Soft blocked:/ {print $2}' | sort -u | head -n1)
  if [[ "$soft_blocked" == yes ]]; then
    rfkill unblock all
    notify "Airplane mode: off"
  else
    rfkill block all
    notify "Airplane mode: on"
  fi
}

open_gui() {
  command -v rog-control-center >/dev/null 2>&1 || die "rog-control-center is not installed"
  uwsm-app -- rog-control-center >/dev/null 2>&1 &
}

case "${1:-status}" in
  status) status_json ;;
  profile) set_profile "${2:-}" ;;
  graphics|gpu) set_graphics "${2:-}" ;;
  keyboard|leds) set_keyboard "${2:-}" ;;
  gui|open-gui) open_gui ;;
  airplane|wireless) toggle_airplane ;;
  aura-static)
    [[ "${2:-}" =~ ^[0-9A-Fa-f]{6}$ ]] || die "aura-static requires a 6-digit RGB value, e.g. 33ccff"
    set_aura_mode static "$2"
    ;;
  aura-mode)
    set_aura_mode "${2:-}" "${3:-ff2244}"
    ;;
  aura-next)
    "$asusctl_bin" aura effect --next-mode >/dev/null 2>&1
    aura_lock_enabled && write_aura_lock "$(aura_mode_name)" "$(aura_color)" || true
    notify "Keyboard Aura: next effect"
    ;;
  aura-lock)
    set_aura_lock "${2:-}"
    ;;
  slash)
    case "${2:-}" in
      on) "$asusctl_bin" slash --enable ;;
      off) "$asusctl_bin" slash --disable ;;
      *) die "slash must be on or off" ;;
    esac
    ;;
  slash-mode)
    set_slash_mode "${2:-}"
    ;;
  slash-brightness)
    set_slash_brightness "${2:-}"
    ;;
  *)
    printf '%s\n' 'Usage: g14ctl {status|gui|profile {adaptive|quiet|balanced|performance|next}|graphics {integrated|hybrid|ultimate}|keyboard {off|low|med|high|up|down|cycle}|aura-static RRGGBB|aura-mode MODE [RRGGBB]|aura-next|aura-lock {on|off|apply}|airplane|slash {on|off}|slash-mode MODE|slash-brightness 0-255}' >&2
    exit 2
    ;;
esac
